@model ImportViewModel
@{
    ViewData["Title"] = "Импорт товаров";
}

<h1>Импорт товаров из CSV</h1>

<form method="post" asp-controller="Products" asp-action="Import" class="mb-4">
    <div class="mb-3">
        <label for="filePath" class="form-label">Путь к CSV-файлу</label>
        <input type="text" id="filePath" name="filePath" value="@Model.FilePath"
               class="form-control" placeholder="/csv/sample_products.csv" />
    </div>
    <button type="submit" class="btn btn-primary">Импортировать товары</button>
</form>

<form method="post" asp-controller="Products" asp-action="ImportUpload" enctype="multipart/form-data" class="mb-4">
    <div class="mb-3">
        <label for="csvFile" class="form-label">Или выберите CSV-файл на компьютере</label>
        <input type="file" id="csvFile" name="csvFile" accept=".csv" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Загрузить и импортировать</button>
</form>

@if (Model.Result != null)
{
    <h2>Результат импорта</h2>
    <table class="table table-bordered w-auto">
        <thead>
            <tr>
                <th>Показатель</th>
                <th>Значение</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Всего строк</td>
                <td>@Model.Result.TotalRows</td>
            </tr>
            <tr>
                <td>Успешно импортировано</td>
                <td>@Model.Result.ImportedCount</td>
            </tr>
            <tr>
                <td>Ошибки</td>
                <td>@Model.Result.ErrorCount</td>
            </tr>
        </tbody>
    </table>

    @if (Model.Result.Errors.Count > 0)
    {
        <h3>Список ошибок</h3>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Строка</th>
                    <th>Описание ошибки</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var error in Model.Result.Errors)
                {
                    <tr>
                        <td>@error.RowNumber</td>
                        <td>@error.Message</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a asp-action="Index" class="btn btn-success">Перейти к списку товаров</a>
}